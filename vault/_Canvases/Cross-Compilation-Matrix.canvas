{
	"nodes": [
		{"id": "title", "type": "text", "text": "# Cross-Compilation Matrix\n\nHost × Target. ✅ = full signed binary. ⚠️ = unsigned only (Apple targets from non-Mac hosts).", "x": -480, "y": -440, "width": 1120, "height": 80},

		{"id": "hdr-target", "type": "text", "text": "**Target →**", "x": -480, "y": -320, "width": 160, "height": 60},
