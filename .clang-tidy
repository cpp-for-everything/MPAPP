# MPAPP clang-tidy configuration.
#
# Wired into the build via the `tidy` preset (-DMPAPP_CLANG_TIDY=ON), which runs
# clang-tidy on first-party targets (mpapp-core, tests, tools) during compile.
# Findings are report-only by default; pass -DMPAPP_TIDY_WERROR=ON to fail the
# build on them. See cmake/MpappHardening.cmake.
#
# Focus on correctness/maintainability families; the noisier stylistic checks
# that fight this codebase's deliberate idioms are disabled individually.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  misc-*,
  clang-analyzer-*,
  modernize-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-avoid-c-arrays

WarningsAsErrors: ''

# Only diagnose MPAPP's own headers — not fetched deps (Catch2, pugixml) or
# system/SDK headers.
HeaderFilterRegex: '.*[/\\](src|include|tools)[/\\].*'

FormatStyle: file
